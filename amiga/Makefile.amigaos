# Omnispeak (Commander Keen 4-6) for AmigaOS 3.x / AmiCradle, 68040 + FPU,
# on acsdl12, with its SDL 1.2 renderer.
#
#   make -f amiga/Makefile.amigaos STOVE=/path/to/os32-gcc16/prefix \
#        NDK=/path/to/gfopensdk/OpenNDK/Include_H \
#        ACSDL=/path/to/amicradle-guest/gameports/acsdl12 \
#        ACSDLLIB=/path/to/acsdl12/build ACGAME=/path/to/acgame \
#        ACGAMELIB=/path/to/acgame/build-amiga
#
# STOVE is GFOpenAmigaGCC 16.2.0-open4 or later. ACSDL is acsdl12, built with
# its own Makefile.amigaos.
# acsdl12 is built with ACG= into ACSDLLIB, without its own copy of ACGame:
# the game gets ACGame from acgame.library, through ACGAMELIB's libacgame.a
# (DalsinAI/acgame's stubs). package/acgame-deps.sh builds both.
# Output: build/amigaos/Omnispeak/ with the program and the episode files it
# needs (data/); run it from a drawer that holds the game's data too.

STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16/prefix
NDK     ?= $(HOME)/AmiCradle/gfopensdk/OpenNDK/Include_H
ACSDL   ?= ../amicradle-guest/gameports/acsdl12
ACSDLLIB ?= $(ACSDL)/build/amigaos
ACGAME  ?= $(ACSDL)/../acgame
ACGAMELIB ?= $(ACGAME)/build-amiga
CC      = $(STOVE)/bin/m68k-amigaos-gcc
CPU     ?= -m68040 -m68881
OPT     ?= -O2 -fomit-frame-pointer
CFLAGS  = -noixemul -std=gnu99 $(OPT) $(CPU) -fcommon -Wall -Wno-unused-variable \
          -Wno-unused-but-set-variable -DWITH_SDL -DWITH_KEEN4 -DWITH_KEEN5 -DWITH_KEEN6 \
          -DKEEN6VER_keen6e15 -I$(ACSDL)/include/SDL -I$(ACGAME)/include -I$(NDK) -Isrc
LDFLAGS = -noixemul $(CPU)
BUILD   = build/amigaos
OUT     = $(BUILD)/Omnispeak

ID      = ck_quit id_mm id_fs id_ca id_cfg id_in id_rf id_sd id_ti id_us_1 id_us_2 \
          id_us_textscreen id_vh id_vl id_str id_vl_sdl12 id_sd_sdl id_in_sdl
CK      = ck_act ck_inter ck_keen ck_obj ck_map ck_phys ck_game ck_play ck_misc ck_main \
          ck_text ck_cross icon
EP      = ck4_map ck4_obj1 ck4_obj2 ck4_obj3 ck4_misc ck5_map ck5_obj1 ck5_obj2 ck5_obj3 \
          ck5_misc ck6_map ck6_obj1 ck6_obj2 ck6_obj3 ck6_misc
OPL     = opl/dbopl opl/nuked_opl3
OBJS    = $(addprefix $(BUILD)/,$(addsuffix .o,$(ID) $(CK) $(EP) $(OPL))) $(BUILD)/stack.o

all: $(OUT)/omnispeak

$(OUT)/omnispeak: $(OBJS) | $(OUT)
	$(CC) $(LDFLAGS) -o $@ $^ $(ACSDLLIB)/libacsdl12.a $(ACGAMELIB)/libacgame.a -lm
	cp -r data/* $(OUT)/

$(BUILD)/stack.o: amiga/stack.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/%.o: src/%.c | $(BUILD)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD) $(OUT):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean
